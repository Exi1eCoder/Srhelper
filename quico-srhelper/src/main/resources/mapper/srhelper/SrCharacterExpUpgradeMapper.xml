<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.quico.srhelper.mapper.SrCharacterExpUpgradeMapper">
    <select id="selectAllOrderByMinLevel" resultType="SrCharacterExpUpgrade">
        select * from sr_character_exp_upgrade order by min_level asc
    </select>
    <select id="selectByLevel" parameterType="Integer" resultType="SrCharacterExpUpgrade">
        select * from sr_character_exp_upgrade where min_level &lt;= #{level} and max_level &gt; #{level}
    </select>
</mapper>