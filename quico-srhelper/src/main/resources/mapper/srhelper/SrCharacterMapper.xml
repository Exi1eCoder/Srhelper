<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.quico.srhelper.mapper.SrCharacterMapper">
    
    <resultMap type="SrCharacter" id="SrCharacterResult">
        <result property="id"    column="id"    />
        <result property="characterName"    column="character_name"    />
        <result property="avatar"    column="avatar"    />
        <result property="gender"    column="gender"    />
        <result property="starLevel"    column="star_level"    />
        <result property="combatTypes"    column="combat_types"    />
        <result property="path"    column="path"    />
        <result property="faction"    column="faction"    />
        <result property="releaseVersion"    column="release_version"    />
        <result property="description"    column="description"    />
        <result property="sortOrder"    column="sort_order"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectSrCharacterVo">
        select id, character_name, avatar, gender, star_level, combat_types, path, faction, release_version, description, sort_order, create_by, create_time, update_by, update_time, remark from sr_character
    </sql>

    <select id="selectSrCharacterList" parameterType="SrCharacter" resultMap="SrCharacterResult">
        <include refid="selectSrCharacterVo"/>
        <where>  
            <if test="characterName != null  and characterName != ''"> and character_name like concat('%', #{characterName}, '%')</if>
            <if test="avatar != null  and avatar != ''"> and avatar = #{avatar}</if>
            <if test="gender != null "> and gender = #{gender}</if>
            <if test="starLevel != null "> and star_level = #{starLevel}</if>
            <if test="combatTypes != null  and combatTypes != ''"> and combat_types = #{combatTypes}</if>
            <if test="path != null  and path != ''"> and path = #{path}</if>
            <if test="faction != null  and faction != ''"> and faction = #{faction}</if>
            <if test="releaseVersion != null  and releaseVersion != ''"> and release_version = #{releaseVersion}</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
        </where>
        ORDER BY sort_order DESC
    </select>
    
    <select id="selectSrCharacterById" parameterType="Long" resultMap="SrCharacterResult">
        <include refid="selectSrCharacterVo"/>
        where id = #{id}
    </select>

    <select id="selectSrCharacterByNameAndVersion" resultMap="SrCharacterResult">
        <include refid="selectSrCharacterVo"/>
        where character_name = #{characterName}
        <choose>
            <when test="releaseVersion != null and releaseVersion != ''">
                and release_version = #{releaseVersion}
            </when>
            <otherwise>
                and release_version is null
            </otherwise>
        </choose>
        limit 1
    </select>

    <insert id="insertSrCharacter" parameterType="SrCharacter" useGeneratedKeys="true" keyProperty="id">
        insert into sr_character
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="characterName != null and characterName != ''">character_name,</if>
            <if test="avatar != null">avatar,</if>
            <if test="gender != null">gender,</if>
            <if test="starLevel != null">star_level,</if>
            <if test="combatTypes != null">combat_types,</if>
            <if test="path != null">path,</if>
            <if test="faction != null">faction,</if>
            <if test="releaseVersion != null">release_version,</if>
            <if test="description != null">description,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="characterName != null and characterName != ''">#{characterName},</if>
            <if test="avatar != null">#{avatar},</if>
            <if test="gender != null">#{gender},</if>
            <if test="starLevel != null">#{starLevel},</if>
            <if test="combatTypes != null">#{combatTypes},</if>
            <if test="path != null">#{path},</if>
            <if test="faction != null">#{faction},</if>
            <if test="releaseVersion != null">#{releaseVersion},</if>
            <if test="description != null">#{description},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateSrCharacter" parameterType="SrCharacter">
        update sr_character
        <trim prefix="SET" suffixOverrides=",">
            <if test="characterName != null and characterName != ''">character_name = #{characterName},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="starLevel != null">star_level = #{starLevel},</if>
            <if test="combatTypes != null">combat_types = #{combatTypes},</if>
            <if test="path != null">path = #{path},</if>
            <if test="faction != null">faction = #{faction},</if>
            <if test="releaseVersion != null">release_version = #{releaseVersion},</if>
            <if test="description != null">description = #{description},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSrCharacterById" parameterType="Long">
        delete from sr_character where id = #{id}
    </delete>

    <delete id="deleteSrCharacterByIds" parameterType="String">
        delete from sr_character where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>