<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.quico.srhelper.mapper.SrGachaItemMapper">
    
    <resultMap type="SrGachaItem" id="SrGachaItemResult">
        <result property="id"    column="id"    />
        <result property="keyword"    column="keyword"    />
        <result property="itemName"    column="item_name"    />
        <result property="itemType"    column="item_type"    />
        <result property="rankType"    column="rank_type"    />
        <result property="srId"    column="sr_id"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectSrGachaItemVo">
        select id, keyword, item_name, item_type, rank_type, sr_id, create_by, create_time, update_by, update_time from sr_gacha_item
    </sql>

    <select id="selectSrGachaItemList" parameterType="SrGachaItem" resultMap="SrGachaItemResult">
        <include refid="selectSrGachaItemVo"/>
        <where>  
            <if test="keyword != null  and keyword != ''"> and keyword = #{keyword}</if>
            <if test="itemName != null  and itemName != ''"> and item_name like concat('%', #{itemName}, '%')</if>
            <if test="itemType != null  and itemType != ''"> and item_type = #{itemType}</if>
            <if test="rankType != null  and rankType != ''"> and rank_type = #{rankType}</if>
        </where>
    </select>
    
    <select id="selectSrGachaItemById" parameterType="Long" resultMap="SrGachaItemResult">
        <include refid="selectSrGachaItemVo"/>
        where id = #{id}
    </select>

    <!-- 尚未绑定卡池项目的角色：sr_gacha_item 中不存在 item_type=character 且 sr_id = 角色ID 的记录。
         sr_id 为 NULL、空串或纯空白时与 cast(id as char) 不相等，自然视为未绑定。 -->
    <select id="selectUnboundCharacters" resultType="com.quico.srhelper.domain.vo.GachaItemBindOptionVO">
        select c.id             as id,
               c.character_name as item_name,
               'character'      as item_type,
               c.avatar         as icon_url,
               c.star_level     as star_level,
               c.path           as path
        from sr_character c
        where not exists (
            select 1
            from sr_gacha_item g
            where g.item_type = 'character'
              and trim(g.sr_id) = cast(c.id as char)
        )
        order by c.sort_order desc, c.id desc
    </select>

    <!-- 尚未绑定卡池项目的光锥：sr_gacha_item 中不存在 item_type=lightcone 且 sr_id = 光锥ID 的记录。
         sr_id 为 NULL、空串或纯空白时与 cast(id as char) 不相等，自然视为未绑定。 -->
    <select id="selectUnboundLightcones" resultType="com.quico.srhelper.domain.vo.GachaItemBindOptionVO">
        select l.id            as id,
               l.lightcone_name as item_name,
               'lightcone'     as item_type,
               l.image         as icon_url,
               l.star_level    as star_level,
               l.path          as path
        from sr_lightcone l
        where not exists (
            select 1
            from sr_gacha_item g
            where g.item_type = 'lightcone'
              and trim(g.sr_id) = cast(l.id as char)
        )
        order by l.sort_order desc, l.id desc
    </select>

    <insert id="insertSrGachaItem" parameterType="SrGachaItem" useGeneratedKeys="true" keyProperty="id">
        insert into sr_gacha_item
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="keyword != null">keyword,</if>
            <if test="itemName != null">item_name,</if>
            <if test="itemType != null">item_type,</if>
            <if test="rankType != null">rank_type,</if>
            <if test="srId != null">sr_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="keyword != null">#{keyword},</if>
            <if test="itemName != null">#{itemName},</if>
            <if test="itemType != null">#{itemType},</if>
            <if test="rankType != null">#{rankType},</if>
            <if test="srId != null">#{srId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateSrGachaItem" parameterType="SrGachaItem">
        update sr_gacha_item
        <trim prefix="SET" suffixOverrides=",">
            <if test="keyword != null">keyword = #{keyword},</if>
            <if test="itemName != null">item_name = #{itemName},</if>
            <if test="itemType != null">item_type = #{itemType},</if>
            <if test="rankType != null">rank_type = #{rankType},</if>
            <if test="srId != null">sr_id = #{srId},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSrGachaItemById" parameterType="Long">
        delete from sr_gacha_item where id = #{id}
    </delete>

    <delete id="deleteSrGachaItemByIds" parameterType="String">
        delete from sr_gacha_item where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>