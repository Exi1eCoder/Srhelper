<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.quico.srhelper.mapper.SrCharacterMaterialBindMapper">
    
    <resultMap type="SrCharacterMaterialBind" id="SrCharacterMaterialBindResult">
        <result property="id"    column="id"    />
        <result property="characterId"    column="character_id"    />
        <result property="characterName"    column="character_name"    />
        <result property="itemAscensionType"    column="item_ascension_type"    />
        <result property="itemId"    column="item_id"    />
        <result property="seriesId"    column="series_id"    />
        <result property="itemName"    column="item_name"    />
        <result property="itemImage"    column="item_image"    />
        <result property="rarityLevel"    column="rarity_level"    />
        <result property="sortOrder"    column="sort_order"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectSrCharacterMaterialBindVo">
        select id, character_id, character_name, item_ascension_type, item_id, series_id, item_name, item_image, rarity_level, sort_order, create_by, create_time, update_by, update_time, remark from sr_character_material_bind
    </sql>

    <select id="selectSrCharacterMaterialBindList" parameterType="SrCharacterMaterialBind" resultMap="SrCharacterMaterialBindResult">
        <include refid="selectSrCharacterMaterialBindVo"/>
        <where>  
            <if test="characterName != null  and characterName != ''"> and character_name like concat('%', #{characterName}, '%')</if>
            <if test="itemAscensionType != null  and itemAscensionType != ''"> and item_ascension_type = #{itemAscensionType}</if>
            <if test="itemName != null  and itemName != ''"> and item_name like concat('%', #{itemName}, '%')</if>
        </where>
    </select>
    
    <select id="selectSrCharacterMaterialBindById" parameterType="Long" resultMap="SrCharacterMaterialBindResult">
        <include refid="selectSrCharacterMaterialBindVo"/>
        where id = #{id}
    </select>

    <insert id="insertSrCharacterMaterialBind" parameterType="SrCharacterMaterialBind" useGeneratedKeys="true" keyProperty="id">
        insert into sr_character_material_bind
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="characterId != null">character_id,</if>
            <if test="characterName != null">character_name,</if>
            <if test="itemAscensionType != null and itemAscensionType != ''">item_ascension_type,</if>
            <if test="itemId != null">item_id,</if>
            <if test="seriesId != null">series_id,</if>
            <if test="itemName != null">item_name,</if>
            <if test="itemImage != null">item_image,</if>
            <if test="rarityLevel != null">rarity_level,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="characterId != null">#{characterId},</if>
            <if test="characterName != null">#{characterName},</if>
            <if test="itemAscensionType != null and itemAscensionType != ''">#{itemAscensionType},</if>
            <if test="itemId != null">#{itemId},</if>
            <if test="seriesId != null">#{seriesId},</if>
            <if test="itemName != null">#{itemName},</if>
            <if test="itemImage != null">#{itemImage},</if>
            <if test="rarityLevel != null">#{rarityLevel},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateSrCharacterMaterialBind" parameterType="SrCharacterMaterialBind">
        update sr_character_material_bind
        <trim prefix="SET" suffixOverrides=",">
            <if test="characterId != null">character_id = #{characterId},</if>
            <if test="characterName != null">character_name = #{characterName},</if>
            <if test="itemAscensionType != null and itemAscensionType != ''">item_ascension_type = #{itemAscensionType},</if>
            <if test="itemId != null">item_id = #{itemId},</if>
            <if test="seriesId != null">series_id = #{seriesId},</if>
            <if test="itemName != null">item_name = #{itemName},</if>
            <if test="itemImage != null">item_image = #{itemImage},</if>
            <if test="rarityLevel != null">rarity_level = #{rarityLevel},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSrCharacterMaterialBindById" parameterType="Long">
        delete from sr_character_material_bind where id = #{id}
    </delete>

    <delete id="deleteSrCharacterMaterialBindByIds" parameterType="String">
        delete from sr_character_material_bind where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteByCharacterId" parameterType="Long">
        delete from sr_character_material_bind where character_id = #{characterId}
    </delete>

    <select id="selectByCharacterId" parameterType="Long" resultMap="SrCharacterMaterialBindResult">
        <include refid="selectSrCharacterMaterialBindVo"/>
        where character_id = #{characterId}
        order by item_ascension_type, rarity_level
    </select>

    <update id="updateCharacterName" parameterType="map">
        update sr_character_material_bind
        set character_name = #{characterName},
            update_time = CURRENT_TIMESTAMP
        where character_id = #{characterId}
    </update>

    <update id="updateItemInfo" parameterType="map">
        update sr_character_material_bind
        set item_name = #{itemName},
            item_image = #{itemImage},
            rarity_level = #{rarityLevel},
            update_time = CURRENT_TIMESTAMP
        where item_id = #{itemId}
    </update>

    <update id="updateItemSeriesId" parameterType="map">
        update sr_character_material_bind
        set series_id = #{seriesId},
            update_time = CURRENT_TIMESTAMP
        where item_id = #{itemId}
    </update>

    <select id="selectAllForSync" resultMap="SrCharacterMaterialBindResult">
        <include refid="selectSrCharacterMaterialBindVo"/>
        order by update_time desc
    </select>
</mapper>