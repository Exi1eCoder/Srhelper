<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.quico.srhelper.mapper.SrRelicSubAffixMapper">

    <resultMap type="SrRelicSubAffix" id="SrRelicSubAffixResult">
        <result property="id"           column="id"             />
        <result property="affixGroupId" column="affix_group_id" />
        <result property="affixId"      column="affix_id"       />
        <result property="property"     column="property"       />
        <result property="base"         column="base"           />
        <result property="step"         column="step"           />
        <result property="stepNum"      column="step_num"       />
        <result property="sortOrder"    column="sort_order"     />
    </resultMap>

    <select id="selectByGroupId" parameterType="String" resultMap="SrRelicSubAffixResult">
        select id, affix_group_id, affix_id, property, base, step, step_num, sort_order
        from sr_relic_sub_affix
        where affix_group_id = #{groupId}
        order by sort_order asc
    </select>

</mapper>
