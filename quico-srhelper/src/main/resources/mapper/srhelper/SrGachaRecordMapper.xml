<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.quico.srhelper.mapper.SrGachaRecordMapper">
    
    <resultMap type="SrGachaRecord" id="SrGachaRecordResult">
        <result property="gachaId"    column="gacha_id"    />
        <result property="gachaType"    column="gacha_type"    />
        <result property="gachaRecordId"    column="gacha_record_id"    />
        <result property="itemId"    column="item_id"    />
        <result property="itemType"    column="item_type"    />
        <result property="name"    column="name"    />
        <result property="rankType"    column="rank_type"    />
        <result property="time"    column="time"    />
        <result property="uid"    column="uid"    />
        <result property="totalPulls"    column="total_pulls"    />
        <result property="pityCount"    column="pity_count"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectSrGachaRecordVo">
        select gacha_id, gacha_type, gacha_record_id, item_id, item_type, name, rank_type, time, uid, total_pulls, pity_count, create_by, create_time, update_by, update_time from sr_gacha_record
    </sql>

    <select id="selectSrGachaRecordList" parameterType="SrGachaRecord" resultMap="SrGachaRecordResult">
        <include refid="selectSrGachaRecordVo"/>
        <where>  
            <if test="gachaId != null  and gachaId != ''"> and gacha_id = #{gachaId}</if>
            <if test="gachaType != null  and gachaType != ''"> and gacha_type = #{gachaType}</if>
            <if test="itemId != null  and itemId != ''"> and item_id = #{itemId}</if>
            <if test="itemType != null  and itemType != ''"> and item_type = #{itemType}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="rankType != null  and rankType != ''"> and rank_type = #{rankType}</if>
            <if test="time != null "> and time = #{time}</if>
            <if test="params.beginTime != null and params.beginTime != ''"> and date_format(time,'%y%m%d') &gt;= date_format(#{params.beginTime},'%y%m%d')</if>
            <if test="params.endTime != null and params.endTime != ''"> and date_format(time,'%y%m%d') &lt;= date_format(#{params.endTime},'%y%m%d')</if>
            <if test="uid != null  and uid != ''"> and uid = #{uid}</if>
            <if test="createBy != null  and createBy != ''"> and create_by = #{createBy}</if>
        </where>
    </select>
    
    <select id="selectSrGachaRecordByGachaRecordId" parameterType="String" resultMap="SrGachaRecordResult">
        <include refid="selectSrGachaRecordVo"/>
        where gacha_record_id = #{gachaRecordId}
    </select>

    <insert id="insertSrGachaRecord" parameterType="SrGachaRecord">
        insert into sr_gacha_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="gachaId != null and gachaId != ''">gacha_id,</if>
            <if test="gachaType != null">gacha_type,</if>
            <if test="gachaRecordId != null">gacha_record_id,</if>
            <if test="itemId != null">item_id,</if>
            <if test="itemType != null">item_type,</if>
            <if test="name != null">name,</if>
            <if test="rankType != null">rank_type,</if>
            <if test="time != null">time,</if>
            <if test="uid != null">uid,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="gachaId != null and gachaId != ''">#{gachaId},</if>
            <if test="gachaType != null">#{gachaType},</if>
            <if test="gachaRecordId != null">#{gachaRecordId},</if>
            <if test="itemId != null">#{itemId},</if>
            <if test="itemType != null">#{itemType},</if>
            <if test="name != null">#{name},</if>
            <if test="rankType != null">#{rankType},</if>
            <if test="time != null">#{time},</if>
            <if test="uid != null">#{uid},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateSrGachaRecord" parameterType="SrGachaRecord">
        update sr_gacha_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="gachaId != null and gachaId != ''">gacha_id = #{gachaId},</if>
            <if test="gachaType != null">gacha_type = #{gachaType},</if>
            <if test="itemId != null">item_id = #{itemId},</if>
            <if test="itemType != null">item_type = #{itemType},</if>
            <if test="name != null">name = #{name},</if>
            <if test="rankType != null">rank_type = #{rankType},</if>
            <if test="time != null">time = #{time},</if>
            <if test="uid != null">uid = #{uid},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where gacha_record_id = #{gachaRecordId}
    </update>

    <delete id="deleteSrGachaRecordByGachaRecordId" parameterType="String">
        delete from sr_gacha_record where gacha_record_id = #{gachaRecordId}
    </delete>

    <delete id="deleteSrGachaRecordByGachaRecordIds" parameterType="String">
        delete from sr_gacha_record where gacha_record_id in 
        <foreach item="gachaRecordId" collection="array" open="(" separator="," close=")">
            #{gachaRecordId}
        </foreach>
    </delete>

    <insert id="insertBatch">
        insert into sr_gacha_record (gacha_id, gacha_type, gacha_record_id, item_id, item_type, name, rank_type, time, uid, total_pulls, pity_count, create_by, create_time)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.gachaId}, #{item.gachaType}, #{item.gachaRecordId}, #{item.itemId}, #{item.itemType}, #{item.name}, #{item.rankType}, #{item.time}, #{item.uid}, #{item.totalPulls}, #{item.pityCount}, #{item.createBy}, #{item.createTime})
        </foreach>
    </insert>

    <select id="selectExistingGachaRecordIds" resultType="java.lang.String">
        select gacha_record_id from sr_gacha_record
        where gacha_record_id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <update id="updateBatch">
        <foreach collection="list" item="item" separator=";">
            update sr_gacha_record
            <set>
                <if test="item.gachaId != null and item.gachaId != ''">gacha_id = #{item.gachaId},</if>
                <if test="item.gachaType != null">gacha_type = #{item.gachaType},</if>
                <if test="item.itemId != null">item_id = #{item.itemId},</if>
                <if test="item.itemType != null">item_type = #{item.itemType},</if>
                <if test="item.name != null">name = #{item.name},</if>
                <if test="item.rankType != null">rank_type = #{item.rankType},</if>
                <if test="item.time != null">time = #{item.time},</if>
                <if test="item.uid != null">uid = #{item.uid},</if>
                <if test="item.updateBy != null">update_by = #{item.updateBy},</if>
                <if test="item.updateTime != null">update_time = #{item.updateTime},</if>
            </set>
            where gacha_record_id = #{item.gachaRecordId}
        </foreach>
    </update>

    <select id="selectMaxTotalPulls" parameterType="SrGachaRecord" resultType="java.lang.Integer">
        select max(total_pulls) from sr_gacha_record
        where create_by = #{createBy}
          and uid = #{uid}
          and gacha_type = #{gachaType}
    </select>

    <select id="selectLastRecord" parameterType="SrGachaRecord" resultMap="SrGachaRecordResult">
        <include refid="selectSrGachaRecordVo"/>
        where create_by = #{createBy}
          and uid = #{uid}
          and gacha_type = #{gachaType}
        order by time desc, gacha_record_id desc
        limit 1
    </select>

    <select id="selectDistinctUidList" parameterType="SrGachaRecord" resultType="java.lang.String">
        select distinct uid from sr_gacha_record
        <where>
            <if test="createBy != null and createBy != ''"> and create_by = #{createBy}</if>
        </where>
        order by uid
    </select>

    <!-- 查询首末时间：数据库直接聚合，只返回一行 -->
    <select id="selectTimeRangeByUid" resultType="com.quico.srhelper.domain.vo.GachaRecordAnalysisResultVO">
        SELECT
        MIN(time) AS firstPullTime,
        MAX(time) AS lastPullTime
        FROM sr_gacha_record
        WHERE uid = #{uid}
    </select>
</mapper>