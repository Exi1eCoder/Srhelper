<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.quico.srhelper.mapper.SrLightConesMapper">
    
    <resultMap type="SrLightCones" id="SrLightConesResult">
        <result property="id"    column="id"    />
        <result property="lightConeName"    column="lightcone_name"    />
        <result property="image"    column="image"    />
        <result property="starLevel"    column="star_level"    />
        <result property="path"    column="path"    />
        <result property="releaseVersion"    column="release_version"    />
        <result property="tag"    column="tag"    />
        <result property="description"    column="description"    />
        <result property="standardType"    column="standard_type"    />
        <result property="standardStartTime"    column="standard_start_time"    />
        <result property="sortOrder"    column="sort_order"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectSrLightConesVo">
        select id, lightcone_name, image, star_level, path, release_version, tag, description, standard_type, standard_start_time, sort_order, create_by, create_time, update_by, update_time from sr_lightcone
    </sql>

    <select id="selectSrLightConesList" parameterType="SrLightCones" resultMap="SrLightConesResult">
        <include refid="selectSrLightConesVo"/>
        <where>  
            <if test="lightConeName != null  and lightConeName != ''"> and lightcone_name like concat('%', #{lightConeName}, '%')</if>
            <if test="starLevel != null "> and star_level = #{starLevel}</if>
            <if test="path != null  and path != ''"> and path = #{path}</if>
            <if test="releaseVersion != null  and releaseVersion != ''"> and release_version = #{releaseVersion}</if>
            <if test="standardType != null "> and standard_type = #{standardType}</if>
        </where>
        ORDER BY sort_order DESC
    </select>
    
    <select id="selectSrLightConesById" parameterType="Long" resultMap="SrLightConesResult">
        <include refid="selectSrLightConesVo"/>
        where id = #{id}
    </select>

    <select id="selectSrLightConesByNameAndVersion" resultMap="SrLightConesResult">
        <include refid="selectSrLightConesVo"/>
        where lightcone_name = #{lightConeName}
        <choose>
            <when test="releaseVersion != null and releaseVersion != ''"> and release_version = #{releaseVersion}</when>
            <otherwise> and release_version IS NULL</otherwise>
        </choose>
        limit 1
    </select>

    <select id="selectSrLightConesListByName" resultMap="SrLightConesResult">
        <include refid="selectSrLightConesVo"/>
        where lightcone_name = #{lightConeName}
    </select>

    <!-- 星缘相遇光锥列表：SQL 强制过滤 standard_type = 2 -->
    <select id="selectCelestialLightconeList" resultType="com.quico.srhelper.domain.vo.CelestialLightconeVO">
        select id, lightcone_name, image, standard_start_time
        from sr_lightcone
        where standard_type = 2
        <if test="lightConeName != null and lightConeName != ''">
            and lightcone_name like concat('%', #{lightConeName}, '%')
        </if>
        order by standard_start_time desc, sort_order desc
    </select>

    <!-- 可选限定光锥下拉：SQL 强制过滤 standard_type = 0 -->
    <select id="selectLimitedLightconeOptions" resultType="com.quico.srhelper.domain.vo.LimitedLightconeOptionVO">
        select id, lightcone_name, image, release_version
        from sr_lightcone
        where standard_type = 0
        <if test="lightConeName != null and lightConeName != ''">
            and lightcone_name like concat('%', #{lightConeName}, '%')
        </if>
        order by sort_order desc
    </select>

    <insert id="insertSrLightCones" parameterType="SrLightCones" useGeneratedKeys="true" keyProperty="id">
        insert into sr_lightcone
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="lightConeName != null and lightConeName != ''">lightcone_name,</if>
            <if test="image != null">image,</if>
            <if test="starLevel != null">star_level,</if>
            <if test="path != null">path,</if>
            <if test="releaseVersion != null">release_version,</if>
            <if test="tag != null">tag,</if>
            <if test="description != null">description,</if>
            <if test="standardType != null">standard_type,</if>
            <if test="standardStartTime != null">standard_start_time,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="lightConeName != null and lightConeName != ''">#{lightConeName},</if>
            <if test="image != null">#{image},</if>
            <if test="starLevel != null">#{starLevel},</if>
            <if test="path != null">#{path},</if>
            <if test="releaseVersion != null">#{releaseVersion},</if>
            <if test="tag != null">#{tag},</if>
            <if test="description != null">#{description},</if>
            <if test="standardType != null">#{standardType},</if>
            <if test="standardStartTime != null">#{standardStartTime},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateSrLightCones" parameterType="SrLightCones">
        update sr_lightcone
        <trim prefix="SET" suffixOverrides=",">
            <if test="lightConeName != null and lightConeName != ''">lightcone_name = #{lightConeName},</if>
            <if test="image != null">image = #{image},</if>
            <if test="starLevel != null">star_level = #{starLevel},</if>
            <if test="path != null">path = #{path},</if>
            <if test="releaseVersion != null">release_version = #{releaseVersion},</if>
            <if test="tag != null">tag = #{tag},</if>
            <if test="description != null">description = #{description},</if>
            <if test="standardType != null">standard_type = #{standardType},</if>
            <if test="standardStartTime != null">standard_start_time = #{standardStartTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <!-- 批量更新光锥常驻类型与加入常驻池时间（星缘相遇：版本联动） -->
    <update id="batchUpdateStandardType">
        update sr_lightcone
        set standard_type = #{standardType},
            standard_start_time = #{standardStartTime},
            update_time = CURRENT_TIMESTAMP
        where id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <delete id="deleteSrLightConesById" parameterType="Long">
        delete from sr_lightcone where id = #{id}
    </delete>

    <delete id="deleteSrLightConesByIds" parameterType="String">
        delete from sr_lightcone where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>