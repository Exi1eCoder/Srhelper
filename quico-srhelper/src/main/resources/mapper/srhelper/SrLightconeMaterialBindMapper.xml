            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteByLightConeId" parameterType="Long">
        delete from sr_lightcone_material_bind where lightcone_id = #{lightconeId}
    </delete>

    <select id="selectSrLightconeMaterialBindList" parameterType="SrLightconeMaterialBind" resultMap="Result">
        <include refid="selectSrLightconeMaterialBindVo"/>
        <where>
            <if test="lightconeId != null"> and lightcone_id = #{lightconeId}</if>
            <if test="lightconeName != null  and lightconeName != ''"> and cone_name like concat('%', #{lightconeName}, '%')</if>
            <if test="itemAscensionType != null  and itemAscensionType != ''"> and item_ascension_type = #{itemAscensionType}</if>
            <if test="itemId != null"> and item_id = #{itemId}</if>
        </where>
    </select>

    <select id="selectSrLightconeMaterialBindById" parameterType="Long" resultMap="Result">
