    <sql id="selectSrLightconeMaterialBindVo">
        select id, lightcone_id, cone_name, item_ascension_type, item_id, series_id, item_name, item_image, rarity_level, sort_order, create_by, create_time, update_by, update_time, remark from sr_lightcone_material_bind
