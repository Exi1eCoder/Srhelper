        set cone_name = #{lightconeName},
            update_time = CURRENT_TIMESTAMP
        where lightcone_id = #{lightconeId}
    </update>

    <delete id="deleteSrLightconeMaterialBindById" parameterType="Long">
        delete from sr_lightcone_material_bind where id = #{id}
    </delete>

    <delete id="deleteSrLightconeMaterialBindByIds" parameterType="String">
        delete from sr_lightcone_material_bind where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
