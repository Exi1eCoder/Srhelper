            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="update" parameterType="SrLightconeMaterialBind">
        update sr_lightcone_material_bind
        <trim prefix="SET" suffixOverrides=",">
            <if test="lightconeName != null">cone_name = #{lightconeName},</if>
            <if test="itemAscensionType != null">item_ascension_type = #{itemAscensionType},</if>
            <if test="itemId != null">item_id = #{itemId},</if>
            <if test="seriesId != null">series_id = #{seriesId},</if>
