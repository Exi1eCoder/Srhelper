    <!-- ==================== 业务自定义方法 ==================== -->

    <select id="selectByLightConeIdAndItemId" resultMap="Result">
        select * from sr_lightcone_material_bind
        where lightcone_id = #{lightconeId} and item_id = #{itemId}
    </select>

    <select id="selectByLightConeId" parameterType="Long" resultMap="Result">
        select * from sr_lightcone_material_bind
        where lightcone_id = #{lightconeId}
        order by sort_order
    </select>

    <insert id="insert" parameterType="SrLightconeMaterialBind" useGeneratedKeys="true" keyProperty="id">
        insert into sr_lightcone_material_bind
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="lightconeId != null">lightcone_id,</if>
            <if test="lightconeName != null">cone_name,</if>
            <if test="itemAscensionType != null">item_ascension_type,</if>
            <if test="itemId != null">item_id,</if>
            <if test="seriesId != null">series_id,</if>
