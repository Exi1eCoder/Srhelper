<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.quico.srhelper.mapper.SrRelicSetPropertyMapper">

    <resultMap type="SrRelicSetProperty" id="SrRelicSetPropertyResult">
        <result property="id"         column="id"          />
        <result property="setId"      column="set_id"      />
        <result property="pieceCount" column="piece_count" />
        <result property="property"   column="property"    />
        <result property="value"      column="value"       />
        <result property="sortOrder"  column="sort_order"  />
    </resultMap>

    <select id="selectSrRelicSetPropertyList" resultMap="SrRelicSetPropertyResult">
        select id, set_id, piece_count, property, value, sort_order
        from sr_relic_set_property
        order by set_id asc, piece_count asc, sort_order asc
    </select>

</mapper>
